<Application
    x:Class="scarDesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:scarDesktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <local:BoolNegationConverter x:Key="BoolNegationConverter" xmlns:local="using:scarDesktop.Converters" />
            <local:IntToVisibilityConverter x:Key="IntToVisibilityConverter" xmlns:local="using:scarDesktop.Converters" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

