<Page
    x:Class="scarDesktop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:scarDesktop.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <vm:LoginViewModel />
    </Page.DataContext>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="300">
            <TextBlock Text="SCAR Login" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBox Header="Email" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="user@example.com"/>
            <PasswordBox x:ConnectionId='2' Header="Password"                                               PlaceholderText="Password"/>
            
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />
            
            <Button Content="Login" Command="{Binding LoginCommand}" HorizontalAlignment="Stretch"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <TextBlock Text="Don't have an account? " Foreground="Gray"/>
                <HyperlinkButton x:ConnectionId='3' Content="Sign up"                            Padding="0"/>
            </StackPanel>

            <ProgressRing IsActive="{Binding IsLoading}" />
        </StackPanel>
    </Grid>
</Page>

